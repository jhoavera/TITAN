# Variables locales recomendadas para desarrollo en TITÁN
# Activar creación automática de ADRs por ensure-tools (local-only)
ENSURE_TOOLS_AUTO_CREATE_ADR=1
# Habilitar instalación automática de herramientas (por defecto true)
ENSURE_TOOLS_AUTO_INSTALL=1
# Permitir acciones que usan sudo (para remover node por ejemplo) - usar con precaución
ENSURE_TOOLS_ALLOW_SUDO=0
