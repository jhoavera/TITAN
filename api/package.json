{
  "name": "titan-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun -r ts-node/register src/index.ts",
    "dev:hono": "bun ./src/infraestructura/servidor/servidor-hono.ts",
    "pruebas": "bun test",
    "revisar-idioma": "bun ./scripts/revisar-idioma.ts",
    "revisar-idioma:node": "bun -r bun/register ./scripts/revisar-idioma.ts",
    "revisar-idioma:bun": "bun ./scripts/revisar-idioma.ts",
    "detectar-fastify": "bun ./scripts/migracion/detectar-fastify.ts",
    "revisar-todo:node": "bun -r bun/register ./scripts/revisar-todo.ts",
    "validar-crear": "bun ./scripts/validar-crear.ts",
    "validar-crear:node": "bun -r bun/register ./scripts/validar-crear.ts",
    "instalar-stack": "bun ./scripts/instalar-stack.ts",
    "instalar-stack:node": "bun -r bun/register ./scripts/instalar-stack.ts",
    "integridad-idioma": "bun -r bun/register ./scripts/servicios/integridad-idioma-service.ts",
    "integridad-idioma:bun": "bun ./scripts/servicios/integridad-idioma-cli.ts",
    "corregir-ingles": "bun -r bun/register ./scripts/servicios/corregir-ingles.ts",
    "corregir-ingles:bun": "bun ./scripts/servicios/corregir-ingles.ts",
    "limpiar-repo": "bun ./scripts/servicios/limpieza-repo.ts",
    "limpiar-repo:apply": "bun ./scripts/servicios/limpieza-repo.ts --apply",
    "limpieza:avanzada": "bun ./scripts/servicios/limpieza-avanzada.ts",
    "limpieza:avanzada:apply": "bun ./scripts/servicios/limpieza-avanzada.ts --apply",
    "limpieza:trazable": "bun ./scripts/servicios/limpieza-trazable.ts",
    "check:imports-relative": "bun ./scripts/checks/check-relative-imports.ts",
    "proponer:imports": "bun ./scripts/proponer-refactor-imports.ts --dry-run",
    "proponer:imports:apply": "bun ./scripts/proponer-refactor-imports.ts --apply-changes",
    "index:generar": "bun ./src/nucleo/indexacion/generador-indices-mcp.ts",
    "indexar-aliases": "bun ./scripts/indexar-aliases.ts",
    "metrics:auto-approve": "bun ./scripts/metrics/consultar-auto-approve.ts",
    "metrics:auto-approve:summary": "bun ./scripts/metrics/sumar-auto-approve.ts --json --write-summary",
    "crear-adr:cli": "bun ./scripts/servicios/crear-adr-cli.ts",
    "crear-termino:cli": "bun ./scripts/servicios/crear-glosario-cli.ts",
    "check-stack": "bun ./scripts/check-stack.ts",
    "check-stack:bun": "bun ./scripts/check-stack.ts",
    "prepush": "bun run check-stack",
    "instal-hooks": "cp .githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push",
    "husky:install": "husky install",
    "prepare": "husky install",
    "setup": "bun install && bun run instal-hooks && bun run husky:install",
    "ci:check-act": "bun ./scripts/ci/check-act-prereqs.ts",
    "analizar-node-compatibilidad": "bun ./scripts/ci/analizar-node-compatibilidad.ts",
    "analizar-node-compatibilidad:bun": "bun ./scripts/ci/analizar-node-compatibilidad.ts",
    "ci:check-act:bun": "bun ./scripts/ci/check-act-prereqs.ts",
    "ensure-tools": "bun ./scripts/ci/ensure-tools.ts",
    "ensure-tools:bun": "bun ./scripts/ci/ensure-tools.ts",
    "remover-node": "ENSURE_TOOLS_REMOVE_NODE=1 ENSURE_TOOLS_ALLOW_SUDO=1 bun ./scripts/ci/ensure-tools.ts",
    "estado-servicios": "bun ./scripts/ci/estado-servicios.ts",
    "estado-servicios:bun": "bun ./scripts/ci/estado-servicios.ts",
    "migrar-node-a-bun:report": "bun ./scripts/ci/generar-reporte-migracion.ts",
    "migrar-node-a-bun:report:bun": "bun ./scripts/ci/generar-reporte-migracion.ts",
    "migrar-node-a-bun:apply": "bun ./scripts/ci/convertir-scripts-a-bun.ts",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d",
    "test:db:stop": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "test:db:wait": "bun ./scripts/ci/wait-for-db.ts",
    "test:db:migrate": "TEST_DATABASE_URL=postgres://test:test@127.0.0.1:5432/test bun ./scripts/ci/aplicar-migraciones-test.ts",
    "test:e2e:db": "bun run test:db:start && bun run test:db:wait && TEST_DATABASE_URL=postgres://test:test@127.0.0.1:5432/test bun run test:db:migrate && TEST_DATABASE_URL=postgres://test:test@127.0.0.1:5432/test bun run pruebas && bun run test:db:stop",
    "ci:verify": "bun run check-stack && bun run ci:check-act",
    "ci:local:drizzle": "bun run test:db:start && bun run test:db:wait && TEST_DATABASE_URL=postgres://test:test@127.0.0.1:5432/test bun run test:db:migrate && TEST_DATABASE_URL=postgres://test:test@127.0.0.1:5432/test bun run pruebas --runInBand && bun run test:db:stop && bun run indexar-aliases && bun run revisar-idioma:bun",
    "dedup:propuestas": "bun ./scripts/servicios/deduplicar-propuestas.ts",
    "dedup:propuestas:apply": "bun ./scripts/servicios/deduplicar-propuestas.ts --apply",
    "dedup:aplicar-seguro": "bun ./scripts/servicios/aplicar-dedup-seguro.ts",
    "dedup:aplicar-seguro:apply": "bun ./scripts/servicios/aplicar-dedup-seguro.ts --apply"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "@types/semver": "^7.3.13",
    "husky": "^8.0.0",
    "ts-node": "^10.9.1",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "hono": "4.6.0",
    "drizzle-orm": "0.32.0",
    "pg": "^8.16.3",
    "semver": "^7.4.0",
    "zod": "3.24.0",
    "pino": "^10.0.0"
  }
}
